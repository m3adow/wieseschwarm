{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":semanticCommitsDisabled"],
  "pre-commit": {
    "enabled": true
  },
  "argocd": {
    "managerFilePatterns": ["/^kubernetes/.+\\.yaml$/"]
  },
  "kubernetes": {
    "managerFilePatterns": ["/^kubernetes/.+\\.yaml$/"]
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "kube-linter image pinned in the local pre-commit hook entry",
      "managerFilePatterns": ["/^\\.pre-commit-config\\.yaml$/"],
      "matchStrings": [
        "entry: stackrox/kube-linter:(?<currentValue>v[\\d.]+) lint"
      ],
      "depNameTemplate": "stackrox/kube-linter",
      "datasourceTemplate": "docker"
    },
    {
      "customType": "regex",
      "description": "ArgoCD upstream install manifest pinned in the bootstrap kustomization",
      "managerFilePatterns": [
        "/^kubernetes/00_bootstrap/argocd/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://raw\\.githubusercontent\\.com/argoproj/argo-cd/(?<currentValue>v[\\d.]+)/manifests/install\\.yaml"
      ],
      "depNameTemplate": "argoproj/argo-cd",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Piraeus operator manifest pinned in the piraeus kustomization",
      "managerFilePatterns": [
        "/^kubernetes/01_infrastructure/piraeus/kustomization\\.yaml$/"
      ],
      "matchStrings": [
        "https://github\\.com/piraeusdatastore/piraeus-operator/releases/download/(?<currentValue>v[\\d.]+)/manifest\\.yaml"
      ],
      "depNameTemplate": "piraeusdatastore/piraeus-operator",
      "datasourceTemplate": "github-releases"
    },
    {
      "customType": "regex",
      "description": "Talos Image Factory installer tag; factory.talos.dev serves no registry tag list, so the version is tracked from siderolabs/talos releases",
      "managerFilePatterns": ["/^talos/.+\\.yaml$/"],
      "matchStrings": [
        "image: factory\\.talos\\.dev/[^:\\s]+:(?<currentValue>v[\\d.]+)"
      ],
      "depNameTemplate": "siderolabs/talos",
      "datasourceTemplate": "github-releases"
    }
  ],
  "packageRules": [
    {
      "description": "Auto-merge minor and patch updates",
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": true,
      "automergeStrategy": "merge-commit"
    },
    {
      "description": "Talos: merging the pin does not upgrade the nodes, so never auto-merge",
      "matchDepNames": ["siderolabs/talos"],
      "automerge": false,
      "prBodyNotes": [
        "Merging this PR only changes the declared installer tag. The nodes keep running the old version until a rolling upgrade is performed with the `talos-upgrader` agent.",
        "Full changelog: https://github.com/siderolabs/talos/releases"
      ]
    },
    {
      "description": "Piraeus: replicated storage, never upgrade unattended",
      "matchDepNames": ["piraeusdatastore/piraeus-operator"],
      "automerge": false,
      "prBodyNotes": [
        "Full changelog: https://github.com/piraeusdatastore/piraeus-operator/releases"
      ]
    }
  ]
}
